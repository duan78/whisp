# Configuration de l'environnement pour Whisp Assistant
# Copiez ce fichier en .env et configurez vos valeurs.
#
# NB : seules les variables ci-dessous sont réellement lues par
# l'application (web_interface.py). Le reste de la configuration (moteur
# STT/TTS, préférences) se fait dans l'interface web et est persisté dans
# la base SQLite (whisp_data.db) — pas via des variables d'environnement.

# === CLÉS API ===
# OpenAI API (pour Whisper). Recommandé : plutôt que ce fichier, utilisez
#   python set_mistral_api_key.py        (stockage chiffré pour Mistral)
# ou la page Configuration de l'interface web (stockage chiffré).
OPENAI_API_KEY=sk-your-openai-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here

# === INTERFACE WEB ===
# Port du serveur web
WEB_PORT=5000

# Hôte du serveur web. 127.0.0.1 (défaut) = accessible uniquement en local ;
# 0.0.0.0 expose l'interface sur le réseau (déconseillé : pas d'authentification)
WEB_HOST=127.0.0.1

# Activer le mode debug Flask (uniquement en développement!)
FLASK_DEBUG=False
